{
  "rewrites": [
    {
      "source": "/r/:code",
      "destination": "/r"
    },
    {
      "source": "/c/:code",
      "destination": "/c"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
